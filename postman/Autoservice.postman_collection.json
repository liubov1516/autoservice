{
  "info": {
    "name": "Autoservice API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "keycloakUrl",
      "value": "http://localhost:8180"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Токени",
      "item": [
        {
          "name": "Токен ADMIN (admin/admin)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{keycloakUrl}}/realms/autoservice/protocol/openid-connect/token"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "autoservice-app"
                },
                {
                  "key": "client_secret",
                  "value": "autoservice-secret"
                },
                {
                  "key": "username",
                  "value": "admin"
                },
                {
                  "key": "password",
                  "value": "admin"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Токен отримано\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"adminToken\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Токен USER (user/user)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{keycloakUrl}}/realms/autoservice/protocol/openid-connect/token"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "autoservice-app"
                },
                {
                  "key": "client_secret",
                  "value": "autoservice-secret"
                },
                {
                  "key": "username",
                  "value": "user"
                },
                {
                  "key": "password",
                  "value": "user"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Токен отримано\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"userToken\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. CRUD (JWT)",
      "item": [
        {
          "name": "Без токена -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401 Unauthorized\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Створити (POST) -> 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientName\": \"Іван Петренко\",\n  \"carModel\": \"Skoda Octavia\",\n  \"plateNumber\": \"AA1234BB\",\n  \"description\": \"Заміна гальмівних колодок\",\n  \"status\": \"NEW\",\n  \"price\": 1500.0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Створено\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"orderId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Прочитати всі (GET) -> 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Прочитати одне (GET) -> 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Оновити (PUT) -> 200",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientName\": \"Іван Петренко\",\n  \"carModel\": \"Skoda Octavia\",\n  \"plateNumber\": \"AA1234BB\",\n  \"description\": \"Заміна гальмівних колодок\",\n  \"status\": \"IN_PROGRESS\",\n  \"price\": 1800.0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Невалідний номер авто (POST) -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientName\": \"Іван Петренко\",\n  \"carModel\": \"Skoda Octavia\",\n  \"plateNumber\": \"ABC123\",\n  \"description\": \"Заміна гальмівних колодок\",\n  \"status\": \"NEW\",\n  \"price\": 1500.0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 Bad Request (ValidPlateNumber)\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Невалідні дані (POST) -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientName\": \"\",\n  \"carModel\": \"\",\n  \"plateNumber\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 Bad Request\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Обмеження: SecurityFilterChain",
      "item": [
        {
          "name": "/api/admin/stats з токеном USER -> 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/stats"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"403 Forbidden\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "/api/admin/stats з токеном ADMIN -> 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/stats"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Обмеження: @PreAuthorize",
      "item": [
        {
          "name": "DELETE з токеном USER -> 403",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"403 (AccessDeniedException)\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE з токеном ADMIN -> 204",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"204 No Content\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Після видалення (GET) -> 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404 Not Found\", function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Кастомні анотації (Лаба №3)",
      "item": [
        {
          "name": "GET /api/orders/whoami без заголовка -> unknown",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/whoami"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"mechanic = unknown\", function () { pm.expect(pm.response.json().mechanic).to.eql(\"unknown\"); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}